# URL base de la API REST (termina en /api). Obligatoria; sin ella la aplicación no arranca.
# Producción: https://api-ollas-prod-fhezb8atcxgmbrfa.eastus-01.azurewebsites.net/api
VITE_API_BASE_URL=http://localhost:8080/api

# demo | real. En "real" se usan los endpoints operativos del Anexo A (ya desplegados en la API de producción).
VITE_OPERATIVO_MODO=demo

# Metas de los KPI nutricionales (opcionales; vacías = no se pinta semáforo). Pedirlas al dueño.
VITE_META_PCAL=
VITE_META_EINS=
